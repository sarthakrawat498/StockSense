# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=StockSense

# ─── Database (PostgreSQL via Prisma) ────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/stocksense?schema=public"
# Direct/unpooled URL for Prisma migrations and seeding
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/stocksense?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── Bootstrap manager seed ──────────────────────────────────────────────────
BOOTSTRAP_MANAGER_PASSWORD="replace-with-a-strong-password"

# ─── Email / OTP (for password reset) ────────────────────────────────────────
# SMTP or transactional email provider
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="no-reply@stocksense.com"
SMTP_PASS="your-smtp-password"
OTP_EXPIRY_MINUTES=10

# ─── Optional / Future ───────────────────────────────────────────────────────
# REDIS_URL="redis://localhost:6379"
# SENTRY_DSN="https://..."
