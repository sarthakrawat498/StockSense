// ─────────────────────────────────────────────────────────────────────────────
// StockSense — Prisma Schema
// Database: PostgreSQL
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
}

enum OperationStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

enum OperationType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
}

enum StockMoveType {
  IN       // goods received (receipt)
  OUT      // goods dispatched (delivery)
  TRANSFER // internal movement
  ADJUST   // manual adjustment
}

// ─── Auth / User ─────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  hashedPassword String
  firstName     String
  lastName      String
  role          UserRole @default(WAREHOUSE_STAFF)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  receipts   Receipt[]
  deliveries Delivery[]
  transfers  Transfer[]
  adjustments Adjustment[]
  otpTokens  OtpToken[]

  @@map("users")
}

model OtpToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_tokens")
}

// ─── Product Catalogue ───────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model UnitOfMeasure {
  id        String   @id @default(cuid())
  name      String   @unique  // e.g. "kg", "pcs", "litre"
  symbol    String            // e.g. "kg", "pcs", "L"
  createdAt DateTime @default(now())

  products Product[]

  @@map("units_of_measure")
}

model Product {
  id           String   @id @default(cuid())
  name         String
  sku          String   @unique
  description  String?
  categoryId   String
  unitId       String
  reorderPoint Int      @default(0)   // trigger low-stock alert below this qty
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category      Category      @relation(fields: [categoryId], references: [id])
  unit          UnitOfMeasure @relation(fields: [unitId], references: [id])
  stockLevels   StockLevel[]
  receiptLines  ReceiptLine[]
  deliveryLines DeliveryLine[]
  transferLines TransferLine[]
  adjustmentLines AdjustmentLine[]
  stockMoves    StockMove[]
  reorderRules  ReorderRule[]

  @@map("products")
}

// ─── Warehouse / Location ─────────────────────────────────────────────────────

model Warehouse {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locations  Location[]
  receipts   Receipt[]
  deliveries Delivery[]
  transfersFrom Transfer[] @relation("TransferFromWarehouse")
  transfersTo   Transfer[] @relation("TransferToWarehouse")

  @@map("warehouses")
}

model Location {
  id          String   @id @default(cuid())
  name        String
  code        String
  warehouseId String
  parentId    String?   // supports nested locations (Rack A → Shelf 1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id])
  parent        Location?    @relation("LocationHierarchy", fields: [parentId], references: [id])
  children      Location[]   @relation("LocationHierarchy")
  stockLevels   StockLevel[]
  movesFrom     StockMove[]  @relation("MoveFromLocation")
  movesTo       StockMove[]  @relation("MoveToLocation")

  @@unique([warehouseId, code])
  @@map("locations")
}

// ─── Stock Levels ─────────────────────────────────────────────────────────────

/// Current on-hand quantity for a product at a specific location.
/// Updated automatically by service layer on each validated operation.
model StockLevel {
  id         String   @id @default(cuid())
  productId  String
  locationId String
  quantity   Decimal  @default(0) @db.Decimal(12, 4)
  updatedAt  DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@map("stock_levels")
}

// ─── Reorder Rules ────────────────────────────────────────────────────────────

model ReorderRule {
  id              String  @id @default(cuid())
  productId       String
  minQty          Decimal @db.Decimal(12, 4)
  maxQty          Decimal @db.Decimal(12, 4)
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@map("reorder_rules")
}

// ─── Operations: Receipt (Incoming Goods) ─────────────────────────────────────

model Receipt {
  id            String          @id @default(cuid())
  reference     String          @unique   // auto-generated e.g. "REC/2024/0001"
  warehouseId   String
  supplierId    String?         // optional until supplier module added
  supplierName  String?
  status        OperationStatus @default(DRAFT)
  scheduledDate DateTime?
  validatedAt   DateTime?
  validatedById String?
  notes         String?
  createdById   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  createdBy   User          @relation(fields: [createdById], references: [id])
  lines       ReceiptLine[]
  stockMoves  StockMove[]

  @@map("receipts")
}

model ReceiptLine {
  id         String   @id @default(cuid())
  receiptId  String
  productId  String
  demandQty  Decimal  @db.Decimal(12, 4)
  doneQty    Decimal  @default(0) @db.Decimal(12, 4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("receipt_lines")
}

// ─── Operations: Delivery (Outgoing Goods) ────────────────────────────────────

model Delivery {
  id             String          @id @default(cuid())
  reference      String          @unique   // e.g. "DEL/2024/0001"
  warehouseId    String
  customerName   String?
  status         OperationStatus @default(DRAFT)
  scheduledDate  DateTime?
  validatedAt    DateTime?
  validatedById  String?
  notes          String?
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  warehouse  Warehouse      @relation(fields: [warehouseId], references: [id])
  createdBy  User           @relation(fields: [createdById], references: [id])
  lines      DeliveryLine[]
  stockMoves StockMove[]

  @@map("deliveries")
}

model DeliveryLine {
  id          String   @id @default(cuid())
  deliveryId  String
  productId   String
  demandQty   Decimal  @db.Decimal(12, 4)
  doneQty     Decimal  @default(0) @db.Decimal(12, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("delivery_lines")
}

// ─── Operations: Internal Transfer ────────────────────────────────────────────

model Transfer {
  id              String          @id @default(cuid())
  reference       String          @unique   // e.g. "INT/2024/0001"
  fromWarehouseId String
  toWarehouseId   String
  fromLocationId  String?
  toLocationId    String?
  status          OperationStatus @default(DRAFT)
  scheduledDate   DateTime?
  validatedAt     DateTime?
  validatedById   String?
  notes           String?
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  fromWarehouse Warehouse      @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse      @relation("TransferToWarehouse",   fields: [toWarehouseId],   references: [id])
  createdBy     User           @relation(fields: [createdById], references: [id])
  lines         TransferLine[]
  stockMoves    StockMove[]

  @@map("transfers")
}

model TransferLine {
  id          String   @id @default(cuid())
  transferId  String
  productId   String
  demandQty   Decimal  @db.Decimal(12, 4)
  doneQty     Decimal  @default(0) @db.Decimal(12, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("transfer_lines")
}

// ─── Operations: Inventory Adjustment ────────────────────────────────────────

model Adjustment {
  id            String          @id @default(cuid())
  reference     String          @unique   // e.g. "ADJ/2024/0001"
  warehouseId   String?
  reason        String?
  status        OperationStatus @default(DRAFT)
  validatedAt   DateTime?
  validatedById String?
  notes         String?
  createdById   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  createdBy  User             @relation(fields: [createdById], references: [id])
  lines      AdjustmentLine[]
  stockMoves StockMove[]

  @@map("adjustments")
}

model AdjustmentLine {
  id            String   @id @default(cuid())
  adjustmentId  String
  productId     String
  locationId    String?
  theoreticalQty Decimal @db.Decimal(12, 4)  // qty in system before adjustment
  countedQty    Decimal  @db.Decimal(12, 4)   // qty counted physically
  difference    Decimal  @db.Decimal(12, 4)   // countedQty - theoreticalQty
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  adjustment Adjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@map("adjustment_lines")
}

// ─── Stock Ledger (Immutable Move History) ────────────────────────────────────

/// Every validated stock movement is recorded here. This is an append-only
/// ledger — rows are never updated or deleted after creation.
model StockMove {
  id             String        @id @default(cuid())
  productId      String
  fromLocationId String?
  toLocationId   String?
  quantity       Decimal       @db.Decimal(12, 4)
  type           StockMoveType
  reference      String        // e.g. "REC/2024/0001"
  operationType  OperationType
  // Polymorphic operation refs (only one will be set)
  receiptId      String?
  deliveryId     String?
  transferId     String?
  adjustmentId   String?
  createdAt      DateTime      @default(now())

  product      Product   @relation(fields: [productId], references: [id])
  fromLocation Location? @relation("MoveFromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location? @relation("MoveToLocation",   fields: [toLocationId],   references: [id])
  receipt      Receipt?  @relation(fields: [receiptId],  references: [id])
  delivery     Delivery? @relation(fields: [deliveryId], references: [id])
  transfer     Transfer? @relation(fields: [transferId], references: [id])
  adjustment   Adjustment? @relation(fields: [adjustmentId], references: [id])

  @@index([productId])
  @@index([reference])
  @@index([createdAt])
  @@map("stock_moves")
}
