// StockSense canonical database schema.
// PostgreSQL + Prisma. Domain checks that depend on operation type or values
// (for example quantity > 0) must also be enforced in the service transaction.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MANAGER
  STAFF
}

enum OperationType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
}

enum OperationStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

enum StockMovementType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(80)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  role         UserRole @default(STAFF)
  warehouseId  String?  @map("warehouse_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  warehouse              Warehouse?             @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  passwordResetOtps      PasswordResetOtp[]
  responsibleOperations  InventoryOperation[]   @relation("OperationResponsibleUser")
  ledgerMovements        StockLedger[]

  @@index([warehouseId])
  @@map("users")
}

model PasswordResetOtp {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_otps")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  code      String   @unique @db.VarChar(30)
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]
  locations          Location[]
  inventoryOperations InventoryOperation[]

  @@map("warehouses")
}

model Location {
  id          String   @id @default(uuid()) @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  name        String   @db.VarChar(120)
  code        String   @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse           Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockBalances       StockBalance[]
  operationsFrom      InventoryOperation[] @relation("OperationFromLocation")
  operationsTo        InventoryOperation[] @relation("OperationToLocation")
  ledgerMovementsFrom StockLedger[]        @relation("LedgerFromLocation")
  ledgerMovementsTo   StockLedger[]        @relation("LedgerToLocation")

  @@unique([warehouseId, code])
  @@index([warehouseId, name])
  @@map("locations")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(160)
  sku          String   @unique @db.VarChar(80)
  categoryId   String   @map("category_id") @db.Uuid
  uom          String   @db.VarChar(20)
  unitCost     Decimal  @map("unit_cost") @db.Decimal(20, 6)
  reorderPoint Decimal  @default(0) @map("reorder_point") @db.Decimal(20, 6)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category        Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  stockBalances   StockBalance[]
  operationItems  InventoryOperationItem[]
  ledgerMovements StockLedger[]

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

model StockBalance {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  locationId  String   @map("location_id") @db.Uuid
  onHandQty   Decimal  @default(0) @map("on_hand_qty") @db.Decimal(20, 6)
  reservedQty Decimal  @default(0) @map("reserved_qty") @db.Decimal(20, 6)
  updatedAt   DateTime @updatedAt @map("updated_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId])
  @@index([locationId])
  @@map("stock_balances")
}

model InventoryOperation {
  id                String          @id @default(uuid()) @db.Uuid
  reference         String          @unique @db.VarChar(30)
  type              OperationType
  status            OperationStatus @default(DRAFT)
  warehouseId       String          @map("warehouse_id") @db.Uuid
  fromLocationId    String?         @map("from_location_id") @db.Uuid
  toLocationId      String?         @map("to_location_id") @db.Uuid
  contactName       String?         @map("contact_name") @db.VarChar(160)
  address           String?
  scheduledDate     DateTime?       @map("scheduled_date")
  responsibleUserId String          @map("responsible_user_id") @db.Uuid
  validatedAt       DateTime?       @map("validated_at")
  canceledAt        DateTime?       @map("canceled_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  warehouse       Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  fromLocation    Location?                @relation("OperationFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation      Location?                @relation("OperationToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  responsibleUser User                     @relation("OperationResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  items           InventoryOperationItem[]
  ledgerEntries   StockLedger[]

  @@index([warehouseId, status])
  @@index([type, status])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([responsibleUserId])
  @@map("inventory_operations")
}

model InventoryOperationItem {
  id             String   @id @default(uuid()) @db.Uuid
  operationId    String   @map("operation_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  quantity       Decimal  @db.Decimal(20, 6)
  countedQuantity Decimal? @map("counted_quantity") @db.Decimal(20, 6)
  createdAt      DateTime @default(now()) @map("created_at")

  operation    InventoryOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  ledgerEntries StockLedger[]

  @@unique([operationId, productId])
  @@index([productId])
  @@map("inventory_operation_items")
}

model StockLedger {
  id              String            @id @default(uuid()) @db.Uuid
  operationId     String            @map("operation_id") @db.Uuid
  operationItemId String            @map("operation_item_id") @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  fromLocationId  String?           @map("from_location_id") @db.Uuid
  toLocationId    String?           @map("to_location_id") @db.Uuid
  quantity        Decimal           @db.Decimal(20, 6)
  movementType    StockMovementType @map("movement_type")
  performedById   String            @map("performed_by_id") @db.Uuid
  movedAt         DateTime          @default(now()) @map("moved_at")

  operation     InventoryOperation     @relation(fields: [operationId], references: [id], onDelete: Restrict)
  operationItem InventoryOperationItem @relation(fields: [operationItemId], references: [id], onDelete: Restrict)
  product       Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromLocation  Location?              @relation("LedgerFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation    Location?              @relation("LedgerToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  performedBy   User                   @relation(fields: [performedById], references: [id], onDelete: Restrict)

  @@index([productId, movedAt])
  @@index([operationId])
  @@index([fromLocationId, movedAt])
  @@index([toLocationId, movedAt])
  @@index([performedById])
  @@map("stock_ledger")
}
